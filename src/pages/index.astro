---
import '@/styles/global.css';
import RoomExperience from '@/components/room/RoomExperience';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const title = 'AdrRoom — Interactive portfolio';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171916" />
    <meta
      name="description"
      content="Explore AdrRoom, an interactive portfolio in Spanish and English."
    />
    <title>{title}</title>
    <link rel="preload" href="/room-preview.png" as="image" />
  </head>
  <body>
    <RoomExperience client:load projects={projects} />
  </body>
</html>

<style is:global>
  html,
  body {
    width: 100%;
    min-width: 320px;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #171916;
  }

  body {
    min-height: 100svh;
  }
</style>
